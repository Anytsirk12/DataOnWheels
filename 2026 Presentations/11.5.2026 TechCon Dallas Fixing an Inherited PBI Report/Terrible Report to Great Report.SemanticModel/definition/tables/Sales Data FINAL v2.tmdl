		annotation SummarizationSetBy = Automatic

	partition 'Sales Data FINAL v2' = calculated
		mode: import
		source =
				SELECTCOLUMNS(
				    Sales,
				    "SalesOrderLineKey", Sales[SalesOrderLineKey],
				    "ProductKey", Sales[ProductKey],
				    "CustomerKey", Sales[CustomerKey],
				    "ResellerKey", Sales[ResellerKey],
				    "SalesTerritoryKey", Sales[SalesTerritoryKey],
				    "OrderDateKey", Sales[OrderDateKey],
				    "Order Quantity", Sales[Order Quantity],
				    "Sales Amount", Sales[Sales Amount],
				    "Total Product Cost", Sales[Total Product Cost],
				    "Profit", Sales[Sales Amount] - Sales[Total Product Cost],
				    "Profit Per Unit", DIVIDE(Sales[Sales Amount] - Sales[Total Product Cost], Sales[Order Quantity]),
				    "Unit Price Calc", DIVIDE(Sales[Sales Amount], Sales[Order Quantity]),
				    "Product", RELATED('Product'[Product]),
				    "Model", RELATED('Product'[Model]),
				    "Subcategory", RELATED('Product'[Subcategory]),
				    "Category", RELATED('Product'[Category]),
				    "Is Bike", IF(RELATED('Product'[Category]) = "Bikes", "Yes", "No"),
				    "State-Province", RELATED(Customer[State-Province]),
				    "Country-Region", RELATED(Customer[Country-Region]),
				    "Order Date", RELATED('Date'[Date]),
				    "Fiscal Year", RELATED('Date'[Fiscal Year]),
				    "Fiscal Quarter", RELATED('Date'[Fiscal Quarter]),
				    "Order Date Text", FORMAT(RELATED('Date'[Date]), "mmmm d, yyyy"),
				    "Month Name", FORMAT(RELATED('Date'[Date]), "mmmm"),
				    "Year Number", YEAR(RELATED('Date'[Date])),
				    "Revenue Text", FORMAT(Sales[Sales Amount], "$#,0.00"),
				    "Order Line Description", RELATED('Product'[Product]) & " | " & RELATED(Customer[State-Province]) & " | " & FORMAT(RELATED('Date'[Date]), "yyyy-mm-dd") & " | Line " & Sales[SalesOrderLineKey],
				    "Row Count Helper", 1
				)

