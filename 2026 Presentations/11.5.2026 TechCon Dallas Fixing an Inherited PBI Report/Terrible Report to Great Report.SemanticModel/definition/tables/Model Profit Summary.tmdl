table 'Model Profit Summary'
	lineageTag: 4378c4e6-6e1d-4dd8-a131-665796d58e1b

	column Category
		lineageTag: dc564612-77ca-479c-a3ac-338016766aa7
		summarizeBy: none
		sourceColumn: [Category]

		annotation SummarizationSetBy = Automatic

	column Model
		lineageTag: 8d556323-537f-4644-86ea-91d0af1b475d
		summarizeBy: none
		sourceColumn: [Model]

		annotation SummarizationSetBy = Automatic

	column 'Total Profit'
		lineageTag: 1dc643f4-7ec5-460d-a4f1-6569adcedf2b
		summarizeBy: sum
		sourceColumn: [Total Profit]

		annotation SummarizationSetBy = Automatic

	column 'Total Qty'
		formatString: 0
		lineageTag: 3d62e53d-e3db-47f6-a453-aef556c5315e
		summarizeBy: sum
		sourceColumn: [Total Qty]

		annotation SummarizationSetBy = Automatic

	partition 'Model Profit Summary' = calculated
		mode: import
		source =
				SELECTCOLUMNS(
				    SUMMARIZECOLUMNS(
				        'Sales Data FINAL v2'[Category],
				        'Sales Data FINAL v2'[Model],
				        "Total Profit", SUM('Sales Data FINAL v2'[Profit]),
				        "Total Qty", SUM('Sales Data FINAL v2'[Order Quantity])
				    ),
				    "Category", 'Sales Data FINAL v2'[Category],
				    "Model", 'Sales Data FINAL v2'[Model],
				    "Total Profit", [Total Profit],
				    "Total Qty", [Total Qty]
				)

