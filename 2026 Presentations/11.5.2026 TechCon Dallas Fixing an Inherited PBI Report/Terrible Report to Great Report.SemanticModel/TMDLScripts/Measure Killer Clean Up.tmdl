				annotation SummarizationSetBy = Automatic
	
			partition 'Sales Data FINAL v2' = calculated
				mode: import
				source =
						SELECTCOLUMNS(
						    Sales,
						    "SalesOrderLineKey", Sales[SalesOrderLineKey],
						    "ProductKey", Sales[ProductKey],
						    "CustomerKey", Sales[CustomerKey],
						    "ResellerKey", Sales[ResellerKey],
						    "SalesTerritoryKey", Sales[SalesTerritoryKey],
						    "OrderDateKey", Sales[OrderDateKey],
						    "Order Quantity", Sales[Order Quantity],
						    "Sales Amount", Sales[Sales Amount],
						    "Total Product Cost", Sales[Total Product Cost],
						    "Profit", Sales[Sales Amount] - Sales[Total Product Cost],
						    "Profit Per Unit", DIVIDE(Sales[Sales Amount] - Sales[Total Product Cost], Sales[Order Quantity]),
						    "Unit Price Calc", DIVIDE(Sales[Sales Amount], Sales[Order Quantity]),
						    "Product", RELATED('Product'[Product]),
						    "Model", RELATED('Product'[Model]),
						    "Subcategory", RELATED('Product'[Subcategory]),
						    "Category", RELATED('Product'[Category]),
						    "Is Bike", IF(RELATED('Product'[Category]) = "Bikes", "Yes", "No"),
						    "State-Province", RELATED(Customer[State-Province]),
						    "Country-Region", RELATED(Customer[Country-Region]),
						    "Order Date", RELATED('Date'[Date]),
						    "Fiscal Year", RELATED('Date'[Fiscal Year]),
						    "Fiscal Quarter", RELATED('Date'[Fiscal Quarter]),
						    "Order Date Text", FORMAT(RELATED('Date'[Date]), "mmmm d, yyyy"),
						    "Month Name", FORMAT(RELATED('Date'[Date]), "mmmm"),
						    "Year Number", YEAR(RELATED('Date'[Date])),
						    "Revenue Text", FORMAT(Sales[Sales Amount], "$#,0.00"),
						    "Order Line Description", RELATED('Product'[Product]) & " | " & RELATED(Customer[State-Province]) & " | " & FORMAT(RELATED('Date'[Date]), "yyyy-mm-dd") & " | Line " & Sales[SalesOrderLineKey],
						    "Row Count Helper", 1
						)
	
		table 'Product List'
			lineageTag: 11c6b158-a888-4898-8a02-f6871ab1db8b
	
			column Category
				lineageTag: 0d75ea0a-d46f-4ebd-ab28-6b44e2103f55
				summarizeBy: none
				sourceColumn: [Category]
	
				annotation SummarizationSetBy = Automatic
	
			column Subcategory
				lineageTag: 5ed5a376-6350-4b31-8199-2ee4674dee0e
				summarizeBy: none
				sourceColumn: [Subcategory]
	
				annotation SummarizationSetBy = Automatic
	
			column Model
				lineageTag: e8d4024f-f7ba-4108-952d-602d11211926
				summarizeBy: none
				sourceColumn: [Model]
	
				annotation SummarizationSetBy = Automatic
	
			column Product
				lineageTag: e99037a0-68c4-4f2e-88e2-5582012a6aad
				summarizeBy: none
				sourceColumn: [Product]
	
				annotation SummarizationSetBy = Automatic
	
			partition 'Product List' = calculated
				mode: import
				source =
						SELECTCOLUMNS(
						    SUMMARIZE('Sales Data FINAL v2', 'Sales Data FINAL v2'[Category], 'Sales Data FINAL v2'[Subcategory], 'Sales Data FINAL v2'[Model], 'Sales Data FINAL v2'[Product]),
						    "Category", 'Sales Data FINAL v2'[Category],
						    "Subcategory", 'Sales Data FINAL v2'[Subcategory],
						    "Model", 'Sales Data FINAL v2'[Model],
						    "Product", 'Sales Data FINAL v2'[Product]
						)
	
		table _Measures
			lineageTag: 1ba31c56-6a66-4b6f-9373-7257e9831947
	
			measure 'Qty Ordered' =
					VAR _fy = VALUES('Date'[Fiscal Year])
					RETURN
					SUMX(
					    FILTER('Sales Data FINAL v2', 'Sales Data FINAL v2'[Fiscal Year] IN _fy),
					    'Sales Data FINAL v2'[Order Quantity]
					)
				lineageTag: 61f88b1d-bb74-4911-b4ca-b3581f7c58f5
	
			measure 'Total Revenue' =
					CALCULATE(
					    SUMX('Sales Data FINAL v2', 'Sales Data FINAL v2'[Sales Amount]),
					    FILTER('Sales Data FINAL v2', 'Sales Data FINAL v2'[Fiscal Year] IN VALUES('Date'[Fiscal Year]))
					)
				lineageTag: 87c34225-cd96-423f-9d7b-5ab5a0ac5429
	
			measure '# Products' =
					COUNTROWS(
					    DISTINCT(
					        SELECTCOLUMNS(
					            FILTER('Sales Data FINAL v2', 'Sales Data FINAL v2'[Fiscal Year] IN VALUES('Date'[Fiscal Year])),
					            "pk", 'Sales Data FINAL v2'[ProductKey]
					        )
					    )
					)
				lineageTag: d4b67892-6ca7-49c2-a19f-9e17d99836b7
	
			measure 'Avg Profit' =
					VAR _fy = VALUES('Date'[Fiscal Year])
					VAR _rows = FILTER('Sales Data FINAL v2', 'Sales Data FINAL v2'[Fiscal Year] IN _fy)
					VAR _profit =
					    SUMX(
					        _rows,
					        CALCULATE(SUM('Sales Data FINAL v2'[Sales Amount])) - CALCULATE(SUM('Sales Data FINAL v2'[Total Product Cost]))
					    )
					VAR _qty = SUMX(_rows, 'Sales Data FINAL v2'[Order Quantity])
					RETURN
					IFERROR(_profit / _qty, 0)
				lineageTag: 2defb5cb-d447-414c-9f8c-19bfbe043372
	
			measure 'Std Cost' =
					VAR _rows = FILTER('Sales Data FINAL v2', 'Sales Data FINAL v2'[Fiscal Year] IN VALUES('Date'[Fiscal Year]))
					RETURN
					SUMX(
					    _rows,
					    VAR _line = 'Sales Data FINAL v2'[SalesOrderLineKey]
					    VAR _check = MIN(1, COUNTROWS(FILTER(ALL('Product List'), LEN('Product List'[Product]) + _line > _line - 100000000)) + 1)
					    RETURN 'Sales Data FINAL v2'[Total Product Cost] * _check
					)
				lineageTag: e944231c-84b4-4cc9-8b52-ac7b3b8c0154
	
			measure 'Avg Profit (Pie)' =
					VAR _fy = VALUES('Date'[Fiscal Year])
					VAR _rows = FILTER('Sales Data FINAL v2', 'Sales Data FINAL v2'[Fiscal Year] IN _fy)
					VAR _profit =
					    SUMX(
					        _rows,
					        VAR _line = 'Sales Data FINAL v2'[SalesOrderLineKey]
					        VAR _check = MIN(1, COUNTROWS(FILTER(_rows, 'Sales Data FINAL v2'[SalesOrderLineKey] <= _line)))
					        RETURN (CALCULATE(SUM('Sales Data FINAL v2'[Sales Amount])) - CALCULATE(SUM('Sales Data FINAL v2'[Total Product Cost]))) * _check
					    )
					VAR _qty = SUMX(_rows, 'Sales Data FINAL v2'[Order Quantity])
					RETURN
					IFERROR(_profit / _qty, 0)
				lineageTag: d9f4731d-c8ca-4543-bf2b-778294dd2ce9
	
			column Placeholder
				isHidden
				formatString: 0
				lineageTag: f2909595-9b6f-4d03-833a-c7fa3ee45fd3
				summarizeBy: sum
				sourceColumn: [Placeholder]
	
				annotation SummarizationSetBy = Automatic
	
			partition _Measures = calculated
				mode: import
				source = ROW("Placeholder", 1)
	
